# Environment Configuration Template
# Copy this file as .env and update values for your environment

# Application Configuration
PROJECT_NAME="Inventory & Order Management System"
PROJECT_VERSION="1.0.0"
ENVIRONMENT="development"

# CORS Configuration
# For local development:
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:5174", "http://localhost:3000"]
# For production (Vercel/Render):
# BACKEND_CORS_ORIGINS="https://your-frontend.vercel.app,http://localhost:5173"

# Database Configuration
# 1. For Local Development (SQLite):
# DATABASE_URL=sqlite:///./ethara.db

# 2. For Supabase PostgreSQL (Production):
# DATABASE_URL=postgresql://postgres.[username]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Note: You can paste your Supabase URL directly (either postgres:// or postgresql://) and we will automatically handle the SQLAlchemy driver prefix.

# 3. For Docker-Compose PostgreSQL:
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}

# Local/Docker PostgreSQL Database Credentials (used by docker-compose)
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=inventory_db
DB_PORT=5432

# Backend Server Configuration
BACKEND_PORT=8000

# Security (change these in production!)
# JWT_SECRET_KEY=your-secret-key-change-in-production
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: Enable Debug Mode (set to false in production)
# DEBUG=false
